# Copy this file to `.env` and fill in real values locally.
# `.env` is listed in .gitignore and must never be committed.
#
# Nothing in this file is required for Phase 1 (no training, no API, no
# frontend exists yet). These are placeholders for future phases.

# Kaggle API credentials (future dataset/training phases).
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Logging verbosity for future scripts (DEBUG, INFO, WARNING, ERROR).
# GENPY_LOG_LEVEL=INFO
