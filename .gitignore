__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.vscode/
.idea/
*.log

checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/instruction/*
!data/instruction/.gitkeep

# Keep small provenance/manifests, ignore generated large manifests.
data/manifests/*
!data/manifests/*.json

# Production data is generated locally and must not be committed.
data/production/*
!data/production/MANIFEST.json

*.egg-info/
dist/
build/
